# setting: (default, validator)
SETTINGS = {
    "dir": (str(HOME / "Downloads" / "AirDrop"), str),
    "receive_seconds": (180, lambda v: max(15, min(1800, int(v)))),
    "mode": ("widget", lambda v: one_of(v, "widget", "app")),              # Plasma only
    "theme": ("system", lambda v: one_of(v, "system", "dark", "light")),   # non-KDE dialogs
    "name": ("", lambda v: str(v).strip()[:60]),          # name others see; empty = host name
    "auto_accept_trusted": (True, lambda v: str(v).lower() in ("1", "true", "yes", "on")),
    "keep_on_seconds": (0, lambda v: max(0, min(300, int(v)))),   # radio stays up after a send/search
    "browse_seconds": (10, lambda v: max(3, min(30, int(v)))),
}
LISTS = ("devices", "trusted")


def one_of(v, *allowed):
    if v not in allowed:
        raise ValueError("use one of: " + ", ".join(allowed))
    return v

RUN.mkdir(parents=True, exist_ok=True)


# ---------------------------------------------------------------- settings
def load_conf():
    c = {k: d for k, (d, _) in SETTINGS.items()}
    c.update({k: [] for k in LISTS})
    src = CONF if CONF.exists() else CONFIG_HOME / "owlydrop.json"   # pre-rename config
    try:
        stored = json.loads(src.read_text())
        if "receive_minutes" in stored and "receive_seconds" not in stored:   # before 1.1
            stored["receive_seconds"] = int(stored["receive_minutes"]) * 60
        for k, v in stored.items():
            if k in SETTINGS:
                try:
                    c[k] = SETTINGS[k][1](v)
                except (ValueError, TypeError):
                    pass                      # keep the default for a bad value
            elif k in LISTS and isinstance(v, list):
                c[k] = [str(x) for x in v]
    except (OSError, ValueError, TypeError):
        pass
    return c


def save_conf(c):
    CONF.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONF.with_suffix(".tmp")
    tmp.write_text(json.dumps(c, indent=2, ensure_ascii=False))
    tmp.replace(CONF)
    write_menus(c)


def parse_duration(v):
    """'30s', '2m', '1m30s' or a plain number of minutes → seconds."""
    v = str(v).strip().lower()
    if re.fullmatch(r"\d+", v):
        return int(v) * 60
    m = re.fullmatch(r"(?:(\d+)\s*m(?:in)?)?\s*(?:(\d+)\s*s(?:ec)?)?", v)
    if not m or not any(m.groups()):
        raise ValueError(f"not a duration: {v}")
    return int(m.group(1) or 0) * 60 + int(m.group(2) or 0)


def fmt_duration(sec):
    m, s = divmod(int(sec), 60)
    return f"{s} s" if not m else f"{m} min" if not s else f"{m} min {s} s"


def same_name(a, b):
    """Device names compare alike whatever apostrophe the device uses (’ vs ')."""
    n = lambda x: re.sub(r"[‘’ʼ`]", "'", x or "").strip().casefold()
    return n(a) == n(b)


def in_list(name, lst):
    return any(same_name(name, x) for x in lst)


def display_name(c):
    return c["name"] or os.uname().nodename


def name_args(c):
    return ["--name", c["name"]] if c["name"] else []


def write_servicemenu(c):
    """Dolphin right-click menu: one entry per saved device, so you always see where it goes."""
    esc = lambda x: '"' + re.sub(r'(["`$\\])', r"\\\1", x) + '"'
    lines = ["[Desktop Entry]", "Type=Service",
             "MimeType=application/octet-stream;inode/directory;",
             "X-KDE-Submenu=Send via AirDrop"]
    devs = c["devices"]
    ids = [f"dev{i}" for i in range(len(devs))] or ["none"]
    lines.append("Actions=" + ";".join(ids) + ";")
    for i, d in enumerate(devs):
        lines += ["", f"[Desktop Action dev{i}]", f"Name={d}", "Icon=computer-tablet",
                  f"Exec={esc(SELF)} send --to {esc(d)} %U"]
    if not devs:
        lines += ["", "[Desktop Action none]", "Name=No devices yet (search in the KDrop widget)",
                  "Icon=dialog-information", f"Exec={esc(SELF)} send %U"]
    try:
        SERVICEMENU.parent.mkdir(parents=True, exist_ok=True)
        SERVICEMENU.write_text("\n".join(lines) + "\n")
        SERVICEMENU.chmod(0o755)
    except OSError:
        pass


def write_script_menu(folder, devs):
    """Files (GNOME) and Caja: a "Send via AirDrop" scripts submenu, one script per device."""
    try:
        if folder.is_dir():
            for f in folder.iterdir():          # only KDrop's own scripts live here
                if f.is_file() and "kdrop" in f.read_text(errors="ignore")[:300]:
                    f.unlink()
        folder.mkdir(parents=True, exist_ok=True)
        entries = {d.replace("/", "∕"): f"exec {shlex.quote(SELF)} send --to {shlex.quote(d)} \"$@\""
                   for d in devs}
        if not entries:
            entries = {"No devices yet": f"exec {shlex.quote(SELF)} send"}
        for name, cmd in entries.items():
            f = folder / name
            f.write_text(f"#!/bin/sh\n# generated by kdrop\n{cmd}\n")
            f.chmod(0o755)
    except OSError:
        pass


def write_nemo_actions(devs):
    """Nemo (Cinnamon): one right-click action per device."""
    try:
        NEMO_ACTIONS.mkdir(parents=True, exist_ok=True)
        for f in NEMO_ACTIONS.glob("kdrop-*.nemo_action"):
            f.unlink()
        for i, d in enumerate(devs):
            (NEMO_ACTIONS / f"kdrop-{i}.nemo_action").write_text(
                "[Nemo Action]\n"
                f"Name=Send via AirDrop to {d.replace('_', '__')}\n"
                f"Comment=Send the selected files to {d} with KDrop\n"
                f"Exec={shlex.quote(SELF)} send --to {shlex.quote(d)} %F\n"
                "Icon-Name=computer-tablet\nSelection=notnone\nExtensions=any;\n")
    except OSError:
        pass


def write_menus(c):
    """Right-click "Send via AirDrop" for every file manager that is installed."""
    write_servicemenu(c)
    if shutil.which("nautilus"):
        write_script_menu(NAUTILUS_DIR, c["devices"])
    if shutil.which("caja"):
        write_script_menu(CAJA_DIR, c["devices"])
    if shutil.which("nemo"):
        write_nemo_actions(c["devices"])


# ---------------------------------------------------------------- widget or app (Plasma)
def plasma_script(js):
    """Run a Plasma desktop script (adds/removes panel widgets). Returns its output or None."""
    for tool in ("qdbus-qt6", "qdbus6", "qdbus"):
        if shutil.which(tool):
            cmd = [tool, "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript", js]
            break
    else:
        if not shutil.which("gdbus"):
            return None
        cmd = ["gdbus", "call", "--session", "--dest", "org.kde.plasmashell", "--object-path",
               "/PlasmaShell", "--method", "org.kde.PlasmaShell.evaluateScript", js]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        return r.stdout if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def apply_mode(mode, launch_app=True):
    """widget: panel widget, no app entry. app: app-menu entry (window + tray icon), no widget.
    Returns an error text, or "" when it worked."""
    if mode == "app":
        APP_ENTRY.parent.mkdir(parents=True, exist_ok=True)
        APP_ENTRY.write_text(
            "[Desktop Entry]\nType=Application\nName=KDrop\n"
            "GenericName=File Sharing with Apple Devices\n"
            "Comment=Send and receive files with iPhone, iPad and Mac\n"
            f"Exec=plasmawindowed --statusnotifier {PLASMOID}\n"
            f"Icon={PLASMOID}\nTerminal=false\nCategories=Network;FileTransfer;\n"
            "Keywords=airdrop;iphone;ipad;share;send;\n")
        WINDOWED_ENTRY.write_text(
            "[Desktop Entry]\n# written by kdrop (app mode): KDrop's icon in the taskbar\n"
            "Name=KDrop\nExec=/usr/bin/plasmawindowed\nTerminal=false\nNoDisplay=true\n"
            f"Icon={PLASMOID}\nType=Application\nX-DBUS-StartupType=Unique\nInitialPreference=1\n"
            "X-KDE-Wayland-Interfaces=org_kde_plasma_window_management,org_kde_kwin_keystate,"
            "zkde_screencast_unstable_v1,org_kde_plasma_activation_feedback\n")
        if launch_app and not app_running():
            subprocess.Popen(["plasmawindowed", "--statusnotifier", PLASMOID], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(1.5)     # let the window appear before the widget (maybe us) goes away
        out = plasma_script(f"""panels().forEach(function (p) {{
            p.widgets("{PLASMOID}").forEach(function (w) {{ w.remove() }}) }}); print("ok")""")
        return "" if out is not None else "Couldn't remove the panel widget. Remove it by hand."
    APP_ENTRY.unlink(missing_ok=True)
    try:
        if "written by kdrop" in WINDOWED_ENTRY.read_text():
            WINDOWED_ENTRY.unlink()
    except OSError:
        pass
    # put the widget back into a panel (the main screen's, preferably)
    out = plasma_script(f"""var have = false;
        panels().forEach(function (p) {{ if (p.widgets("{PLASMOID}").length) have = true }});
        if (!have && panels().length) {{
            // the main screen's panel with a system tray, else any panel with one, else the first
            var target = null;
            panels().forEach(function (p) {{
                if (!p.widgets("org.kde.plasma.systemtray").length) return;
                if (!target || (p.screen == 0 && target.screen != 0)) target = p;
            }});
            if (!target) target = panels()[0];
            target.addWidget("{PLASMOID}");
        }}
        print(have ? "present" : "added")""")
    # close the app window last: when switching from inside it, this process is its child
    subprocess.run(["pkill", "-f", f"plasmawindowed.* {PLASMOID}$"], capture_output=True)
    return "" if out is not None else \
        "Couldn't add the widget. Right-click the panel → Add Widgets… → KDrop."


def app_running():
    return subprocess.run(["pgrep", "-f", f"plasmawindowed.* {PLASMOID}$"],
                          capture_output=True).returncode == 0


# ---------------------------------------------------------------- utilities
def write_job(kind, **kw):
    kw.update(kind=kind, time=time.time())
    p = RUN / f"{kind}.json"
    tmp = p.with_suffix(".tmp")
    tmp.write_text(json.dumps(kw, ensure_ascii=False))
    tmp.replace(p)


def read_job(kind):
    try:
        return json.loads((RUN / f"{kind}.json").read_text())
    except (OSError, ValueError):
        return None


def systemctl(*args):
    return subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True)


def unit_active(unit):
    return systemctl("is-active", "--quiet", unit).returncode == 0


def notify(title, body="", icon="document-send", actions=None):
    """Desktop notification; with actions it blocks and returns the chosen key."""
    cmd = ["notify-send", "-a", APP, "-i", icon, title, body]
    for key, label in (actions or {}).items():
        cmd += ["-A", f"{key}={label}"]
    if not actions:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return ""
    try:
        return subprocess.run(cmd[:1] + ["--wait"] + cmd[1:], capture_output=True,
                              text=True, timeout=600).stdout.strip()
    except subprocess.TimeoutExpired:
        return ""


def notify_progress(*a, **kw):
    """Progress notices for desktops without the widget (`--notify`)."""
    if os.environ.get("KDROP_NOTIFY"):
        notify(*a, **kw)


def notify_async(*a, on_action=None, **kw):
    def run():
        key = notify(*a, **kw)
        if key and on_action:
            on_action(key)
    threading.Thread(target=run, daemon=True).start()


def open_path(p):
    subprocess.Popen(["xdg-open", str(p)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def to_path(s):
    if s.startswith("file://"):
        s = urllib.parse.unquote(urllib.parse.urlparse(s).path)
    return pathlib.Path(s).expanduser()


def stream(fd):
    """Yield (line, partial) from a raw fd, split on \\r and \\n.
    Every 0.5 s without output yields (None, partial) so callers can check timers and prompts."""
    buf = ""
    while True:
        r, _, _ = select.select([fd], [], [], 0.5)
        if not r:
            yield None, buf
            continue
        try:
            data = os.read(fd, 4096)
        except OSError:
            data = b""
        if not data:
            if buf.strip():
                yield buf, ""
            return
        buf += data.decode("utf-8", "replace")
        parts = re.split(r"[\r\n]+", buf)
        buf = parts.pop()
        for p in parts:
            if p.strip():
                yield p, buf


# -------------------------------------------------------------------- radio
def radio_is_up():
    r = subprocess.run(["ip", "-6", "-o", "addr", "show", "dev", "awdl0"],
                       capture_output=True, text=True)
    return "fe80" in r.stdout


def radio_up(timeout=45):
    """Bring the AirDrop radio up (Wi-Fi pauses) and wait until awdl0 has its address."""
    systemctl("stop", f"{RADIO_OFF}.timer")   # a pending keep-on shutdown is cancelled
    if not unit_active(RADIO_UNIT):
        systemctl("reset-failed", RADIO_UNIT)
        subprocess.run(["systemd-run", "--user", "--collect", "--quiet", f"--unit={RADIO_UNIT}",
                        "-p", "KillSignal=SIGINT", "-p", "TimeoutStopSec=20",
                        "-p", "RuntimeMaxSec=1800",   # safety net: Wi-Fi always comes back
                        OWLY, "radio", "up"], check=True)
    t0 = time.time()
    while time.time() - t0 < timeout:
        if radio_is_up():
            time.sleep(0.5)
            return True
        if not unit_active(RADIO_UNIT):
            break
        time.sleep(0.2)
    return False


def radio_error():
    r = subprocess.run(["journalctl", "--user", "-u", RADIO_UNIT, "-n", "4", "-o", "cat", "--no-pager"],
                       capture_output=True, text=True)
    lines = r.stdout.strip().splitlines()
    return lines[-1] if lines else "the AirDrop radio did not come up"


def radio_release(me, keep_on=0):
    """Give Wi-Fi back, unless another job still needs the radio.
    With keep_on > 0 the radio stays up that many seconds more, so a follow-up
    send reuses it instead of costing another Wi-Fi reconnect."""
    if any(unit_active(u) for k, u in JOB_UNITS.items() if k != me):
        return
    if keep_on > 0 and unit_active(RADIO_UNIT):
        systemctl("stop", f"{RADIO_OFF}.timer")
        (RUN / "released").write_text(str(time.time() + keep_on))
        subprocess.run(["systemd-run", "--user", "--collect", "--quiet", f"--unit={RADIO_OFF}",
                        f"--on-active={keep_on}", "systemctl", "--user", "stop", RADIO_UNIT],
                       capture_output=True)
        return
    radio_down()


def radio_down():
    systemctl("stop", f"{RADIO_OFF}.timer")
    if unit_active(RADIO_UNIT):
        (RUN / "released").write_text(str(time.time()))
    systemctl("stop", RADIO_UNIT)


def wifi_state():
    """'connected', 'connecting' or 'off' for the Wi-Fi station."""
    r = subprocess.run(["nmcli", "-t", "-f", "TYPE,STATE", "device"], capture_output=True, text=True)
    states = [l.split(":", 1)[1] for l in r.stdout.splitlines() if l.startswith("wifi:")]
    if any(s.startswith("connected") for s in states):
        return "connected"
    if any(s.startswith("connecting") or s == "disconnected" for s in states):
        return "connecting"
    return "off"


# ------------------------------------------------------------------- send
def prepare_files(items):
    out, tmpdir = [], RUN / "zips"
    for s in items:
        p = to_path(s)
        if p.is_dir():
            tmpdir.mkdir(exist_ok=True)
            out.append(shutil.make_archive(str(tmpdir / p.name), "zip", root_dir=p.parent, base_dir=p.name))
        elif p.is_file():
            out.append(str(p))
    return out


def job_send(items, to):
    conf = load_conf()
    if not to:  # never "whoever answers first"
        write_job("send", state="error", text="Choose a device first")
        notify("No device chosen", "Search for devices in the KDrop widget and pick one.", "dialog-warning")
        return 1
    files = prepare_files(items)
    if not files:
        write_job("send", state="error", text="Nothing to send")
        notify("Nothing to send", "Pick files or folders.", "dialog-warning")
        return 1
    label = os.path.basename(files[0]) + (f" +{len(files) - 1} more" if len(files) > 1 else "")
    write_job("send", state="radio", text="Turning on AirDrop (Wi-Fi paused)…", files=label, peer=to)
    ok = False
    try:
        if not radio_up():
            err = radio_error()
            write_job("send", state="error", text=err, files=label)
            notify("AirDrop radio failed", err, "dialog-error")
            return 1
        write_job("send", state="looking", files=label, peer=to,
                  text=f"Looking for {to}… (unlocked, AirDrop: Everyone)")
        cmd = [OWLY, "send", "--seconds", "40", "--to", to, *name_args(conf), *files]
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        last, peer = "", ""
        for line, _ in stream(p.stdout.fileno()):
            if line is None:
                continue
            line = line.strip()
            last = line
            m = re.match(r'sending to "(.+?)" at', line)
            if m:
                peer = m.group(1)
                if not same_name(peer, to):
                    # somebody else answered: stop before anything is offered to them
                    p.kill()
                    p.wait()
                    msg = f"“{peer}” answered instead of “{to}”. Nothing was sent."
                    write_job("send", state="error", files=label, text=msg)
                    notify("AirDrop send cancelled", msg, "dialog-warning")
                    return 1
                write_job("send", state="asking", files=label, peer=peer,
                          text=f"Waiting for {peer} to accept…")
            elif line == "accepted":
                write_job("send", state="sending", files=label, peer=peer, progress=0,
                          text=f"Sending to {peer}…")
            elif line == "delivered":
                ok = True
            m = re.match(r"(\d+) / (\d+) bytes", line)
            if m and int(m.group(2)):
                pct = int(int(m.group(1)) * 100 / int(m.group(2)))
                write_job("send", state="sending", files=label, peer=peer, progress=pct,
                          text=f"Sending to {peer}… {pct}%")
        rc = p.wait()
        if ok or rc == 0:
            ok = True
            write_job("send", state="done", files=label, peer=peer or to, text=f"Sent to {peer or to}")
            notify(f"Sent to {peer or to}", label, "emblem-success")
            return 0
        msg = last.removeprefix("owly: ") or f"owly exited with {rc}"
        if "declin" in msg.lower():
            msg = f"{peer or to} declined"
        elif "looking for" in msg.lower() or "not found" in msg.lower() or not peer:
            msg = f"{to} not found. Is it unlocked, nearby and set to AirDrop: Everyone?"
        write_job("send", state="error", files=label, text=msg)
        notify("AirDrop send failed", msg, "dialog-error")
        return 1
    finally:
        radio_release("send", conf["keep_on_seconds"] if ok else 0)
        shutil.rmtree(RUN / "zips", ignore_errors=True)


# ---------------------------------------------------------------- receive
ALWAYS = "Always accept from this device"


def system_dark():
    """True/False from the desktop's dark-style preference (freedesktop portal, then GNOME),
    None when the desktop doesn't say."""
    try:
        out = subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.portal.Desktop",
                              "--object-path", "/org/freedesktop/portal/desktop", "--method",
                              "org.freedesktop.portal.Settings.ReadOne",
                              "org.freedesktop.appearance", "color-scheme"],
                             capture_output=True, text=True, timeout=3).stdout
        m = re.search(r"uint32 (\d)", out)
        if m and m.group(1) in "12":
            return m.group(1) == "1"          # 1 = prefer dark, 2 = prefer light
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:
        out = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "color-scheme"],
                             capture_output=True, text=True, timeout=3).stdout
        if "dark" in out or "light" in out:
            return "dark" in out
    except (OSError, subprocess.TimeoutExpired):
        pass
    return None


def gtk_dialog_env():
    """Environment for zenity so it matches the chosen theme (Settings → theme), even when
    a custom GTK theme in ~/.config/gtk-4.0 would force it light or dark."""
    theme = load_conf()["theme"]
    dark = system_dark() if theme == "system" else theme == "dark"
    env = dict(os.environ)
    if dark is None:
        return env
    clean = RUN / "gtk-config"            # empty config dir: no user gtk.css overrides
    clean.mkdir(exist_ok=True)
    env.pop("GTK_THEME", None)
    env.update(XDG_CONFIG_HOME=str(clean),
               ADW_DEBUG_COLOR_SCHEME="force-dark" if dark else "force-light")
    return env


def ask_accept(sender, files):
    """Accept / Always accept / Decline. Uses kdialog (KDE), zenity (GNOME and most others),
    or a notification with buttons as a last resort. Declines by itself after 60 s."""
    body = f"{sender} wants to send:\n\n" + "\n".join(f"  • {f}" for f in files[:12])
    if len(files) > 12:
        body += f"\n  … and {len(files) - 12} more"
    title = f"{APP} – AirDrop"
    try:
        if shutil.which("kdialog"):
            rc = subprocess.run(["kdialog", "--title", title, "--yesnocancel", body,
                                 "--yes-label", "Accept", "--no-label", ALWAYS,
                                 "--cancel-label", "Decline"], timeout=60).returncode
            return {0: "yes", 1: "always"}.get(rc, "no")
        if shutil.which("zenity"):
            r = subprocess.run(["zenity", "--question", "--title", title, "--text", body,
                                "--no-markup", "--width", "420", "--timeout", "60",
                                "--ok-label", "Accept", "--cancel-label", "Decline",
                                "--extra-button", ALWAYS],
                               capture_output=True, text=True, timeout=65, env=gtk_dialog_env())
            if r.returncode == 0:
                return "yes"
            return "always" if r.stdout.strip() == ALWAYS else "no"
        r = subprocess.run(["notify-send", "--wait", "-u", "critical", "-a", APP,
                            "-i", "document-save", title, body,
                            "-A", "yes=Accept", "-A", f"always={ALWAYS}", "-A", "no=Decline"],
                           capture_output=True, text=True, timeout=60)
        return r.stdout.strip() if r.stdout.strip() in ("yes", "always") else "no"
    except (subprocess.TimeoutExpired, OSError):
        return "no"


def job_receive(seconds):
    conf = load_conf()
    seconds = seconds or conf["receive_seconds"]
    dest = pathlib.Path(conf["dir"]).expanduser()
    dest.mkdir(parents=True, exist_ok=True)
    stop = {"flag": False}
    signal.signal(signal.SIGTERM, lambda *_: stop.update(flag=True))
    write_job("receive", state="radio", text="Turning on AirDrop (Wi-Fi paused)…")
    proc, received = None, []
    try:
        if not radio_up():
            err = radio_error()
            write_job("receive", state="error", text=err)
            notify("AirDrop radio failed", err, "dialog-error")
            return 1
        master, slave = pty.openpty()   # owly asks "accept? [y/N]" on a terminal
        proc = subprocess.Popen([OWLY, "receive", "--dir", str(dest), *name_args(conf)],
                                stdin=slave, stdout=slave, stderr=slave, close_fds=True)
        os.close(slave)
        deadline = time.time() + seconds
        sender, offered, answered = "", [], True
        notify_progress(f"Visible as “{display_name(conf)}” for {fmt_duration(seconds)}",
                        "On the iPhone, iPad or Mac: Share → AirDrop → this computer.",
                        "network-wireless")
        for line, partial in stream(master):
            if stop["flag"] or proc.poll() is not None or time.time() > deadline:
                break
            left = int(deadline - time.time())
            write_job("receive", state="receiving", until=deadline, received=len(received),
                      text=f"Visible as “{display_name(conf)}” · {left // 60}:{left % 60:02d} left")
            if not answered and "accept? [y/N]" in (line or "") + partial:
                answered = True
                conf = load_conf()
                if conf["auto_accept_trusted"] and in_list(sender, conf["trusted"]):
                    answer = "yes"
                else:
                    answer = ask_accept(sender or "A device", offered)
                if answer == "always":
                    conf = load_conf()
                    if not in_list(sender, conf["trusted"]):
                        conf["trusted"].append(sender)
                    if not in_list(sender, conf["devices"]):
                        conf["devices"].append(sender)
                    save_conf(conf)
                os.write(master, b"y\n" if answer in ("yes", "always") else b"n\n")
                deadline = time.time() + seconds
                continue
            if line is None:
                continue
            line = line.strip()
            m = re.match(r'"(.+?)" \(".*?"\) wants to send', line)
            if m:
                sender, offered, answered = m.group(1), [], False
                deadline = time.time() + seconds
                continue
            m = re.match(r'"(.+?)" \S+', line)
            if m and not answered:
                offered.append(m.group(1))
                continue
            if line.startswith("/") and os.path.exists(line):
                received.append(line)
                deadline = time.time() + seconds
                path = pathlib.Path(line)
                notify_async(f"Received from {sender or 'AirDrop'}", path.name, "folder-download",
                             actions={"open": "Open", "folder": "Show in folder"},
                             on_action=lambda k, p=path: open_path(p if k == "open" else p.parent))
            elif re.match(r"https?://", line):
                received.append(line)
                notify_async(f"Link from {sender or 'AirDrop'}", line, "internet-web-browser",
                             actions={"open": "Open"}, on_action=lambda k, u=line: open_path(u))
        n = len(received)
        write_job("receive", state="done", received=n,
                  text=f"Receiving ended · {n} item{'s' * (n != 1)} received")
        return 0
    finally:
        if proc and proc.poll() is None:
            proc.send_signal(signal.SIGINT)
            try:
                proc.wait(5)
            except subprocess.TimeoutExpired:
                proc.kill()
        radio_release("receive")
        notify_progress("Receiving ended", f"{len(received)} received. Wi-Fi is reconnecting.",
                        "network-wireless")


# ----------------------------------------------------------------- browse
def job_browse():
    conf = load_conf()
    write_job("browse", state="radio", text="Turning on AirDrop (Wi-Fi paused)…")
    found = []
    try:
        if not radio_up():
            err = radio_error()
            write_job("browse", state="error", text=err)
            notify_progress("AirDrop radio failed", err, "dialog-error")
            return 1
        write_job("browse", state="looking", found=[], text="Looking for devices… (AirDrop: Everyone)")
        notify_progress("Looking for devices…", "Wi-Fi is paused for a few seconds.", "edit-find")
        limit = conf["browse_seconds"]
        p = subprocess.Popen([OWLY, "browse", "--seconds", str(limit), *name_args(conf)],
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        end = time.time() + limit + 2
        for line, _ in stream(p.stdout.fileno()):
            if line:
                m = re.match(r'^\S+\s+"(.+?)" \(', line.strip())
                if m and not in_list(m.group(1), found):
                    found.append(m.group(1))
                    # stop soon after the first answer: devices nearby answer together,
                    # and every second here is a second without Wi-Fi
                    end = min(end, time.time() + 2.5)
                    write_job("browse", state="looking", found=found,
                              text="Found: " + ", ".join(found) + " …")
            if time.time() > end:
                break
        if p.poll() is None:
            p.send_signal(signal.SIGINT)
            try:
                p.wait(3)
            except subprocess.TimeoutExpired:
                p.kill()
        conf = load_conf()
        conf["devices"] += [n for n in found if not in_list(n, conf["devices"])]
        save_conf(conf)
        notify_progress(("Found: " + ", ".join(found)) if found else "No devices found",
                        "Right-click files → Send via AirDrop → device." if found else
                        "Unlock the device and set AirDrop to Everyone for 10 minutes.",
                        "computer-tablet" if found else "dialog-warning")
        write_job("browse", state="done", found=found,
                  text=("Found: " + ", ".join(found)) if found else
                  "No devices found. Unlock the device and set AirDrop to Everyone.")
        return 0
    finally:
        radio_release("browse", conf["keep_on_seconds"] if found else 0)


