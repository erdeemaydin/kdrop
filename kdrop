PICK_PID = RUN / "pick-files.pid"


def kdialog_env():
    """Isolated XDG_CONFIG_HOME for kdialog so it does not inherit plasmashell's
    oversized file-dialog icons or another app's maximized state, while still
    keeping the user's KDE theme, colors, and Places."""
    dconf = DATA_HOME / "kdrop" / "dialog-config"
    dconf.mkdir(parents=True, exist_ok=True)
    for name in ("kdeglobals", "breezerc", "klassyrc", "lightlyrc", "oxygenrc",
                 "Kvantum", "qt6ct", "kioslaverc", "user-dirs.dirs", "Trolltech.conf"):
        src = CONFIG_HOME / name
        dst = dconf / name
        if dst.is_symlink() and not dst.exists():
            dst.unlink(missing_ok=True)
        if src.exists() and not dst.exists():
            try:
                dst.symlink_to(src)
            except OSError:
                pass
    env = dict(os.environ)
    env["XDG_CONFIG_HOME"] = str(dconf)
    return env, dconf / "kdialogrc"


def has_saved_dialog_size(rc):
    """True once kdialog has recorded a user-chosen FileDialogSize."""
    try:
        return rc.exists() and "[FileDialogSize]" in rc.read_text(errors="replace")
    except OSError:
        return False


def cancel_pick():
    """Close an open file-picker dialog if the KDrop popup was dismissed."""
    try:
        pid = int(PICK_PID.read_text().strip())
    except (OSError, ValueError):
        return 0
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    except OSError:
        return 1
    PICK_PID.unlink(missing_ok=True)
    return 0


def pick_dialog(kind, geom="", start_dir=""):
    """Open an independent KDE file/folder chooser window and print JSON."""
    if not shutil.which("kdialog"):
        print("kdialog not found", file=sys.stderr)
        return 127
    env, rc = kdialog_env()
    cmd = ["kdialog"]
    if geom and re.fullmatch(r"\d+x\d+", geom) and not has_saved_dialog_size(rc):
        cmd += ["--geometry", geom]
    cmd += ["--icon", PLASMOID]
    if kind == "folder":
        cmd += ["--title", "Save received files to", "--getexistingdirectory"]
        if start_dir:
            cmd.append(start_dir)
    else:
        cmd += ["--title", "Choose files to send",
                "--getopenfilename", "--multiple", "--separate-output"]
        if not rc.exists():
            cmd.append(str(HOME))
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env)
    if kind == "files":
        PICK_PID.write_text(f"{proc.pid}\n")
    try:
        out, err = proc.communicate()
    finally:
        if kind == "files":
            try:
                if PICK_PID.exists() and PICK_PID.read_text().strip() == str(proc.pid):
                    PICK_PID.unlink(missing_ok=True)
            except OSError:
                pass
    if proc.returncode in (1, -signal.SIGTERM, -signal.SIGKILL):
        print(json.dumps({"cancelled": True, "urls": []}, ensure_ascii=False))
        return 0
    if proc.returncode != 0:
        if err:
            print(err, file=sys.stderr, end="")
        return proc.returncode
    if kind == "folder":
        print(json.dumps({"path": out.strip()}, ensure_ascii=False))
        return 0
    urls = [pathlib.Path(p).as_uri() for p in out.splitlines() if p.strip()]
    print(json.dumps({"urls": urls}, ensure_ascii=False))
    return 0


def launch(kind, args):
    """Run a job in its own systemd user unit, so it outlives the widget or Dolphin."""
    unit = JOB_UNITS[kind]
    if unit_active(unit):
        notify("KDrop is busy", f"A {kind} is already running.", "dialog-information")
        return 1
    systemctl("reset-failed", unit)
    env = []
    for k in ("DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY", "DBUS_SESSION_BUS_ADDRESS",
              "XDG_CURRENT_DESKTOP", "XDG_SESSION_TYPE", "KDROP_NOTIFY"):
        if os.environ.get(k):
            env += ["-E", f"{k}={os.environ[k]}"]
    write_job(kind, state="radio", text="Starting…")
    return subprocess.run(["systemd-run", "--user", "--collect", "--quiet", f"--unit={unit}",
                           "-p", "KillSignal=SIGTERM", "-p", "TimeoutStopSec=25", *env,
                           sys.executable, SELF, "_run", kind, *args]).returncode


def status():
    conf = load_conf()
    jobs = {}
    for kind, unit in JOB_UNITS.items():
        j = read_job(kind)
        if not j:
            continue
        j["active"] = unit_active(unit)
        if not j["active"] and j.get("state") in ("radio", "looking", "asking", "sending", "receiving"):
            j["state"], j["text"] = "error", "Stopped"
        if j["active"] or time.time() - j["time"] < 20:
            jobs[kind] = j
    radio = unit_active(RADIO_UNIT)
    wifi = "airdrop" if radio else wifi_state()
    try:
        released = float((RUN / "released").read_text())
    except (OSError, ValueError):
        released = 0
    if wifi == "off" and not radio and 0 <= time.time() - released < 90:
        wifi = "connecting"   # NetworkManager is taking the card back after AirDrop
    elif wifi != "connected" and not radio and time.time() - released > 90:
        wifi = "off"   # not something KDrop caused
    out = {"version": VERSION, "radio": radio, "wifi": wifi,
           "keep_on": unit_active(f"{RADIO_OFF}.timer"), "jobs": jobs,
           "host": display_name(conf), "hostname": os.uname().nodename,
           "owly": os.path.exists(OWLY)}
    out.update({k: conf[k] for k in SETTINGS})
    out["plasma"] = bool(shutil.which("plasmawindowed"))
    out.update({k: conf[k] for k in LISTS})
    print(json.dumps(out, ensure_ascii=False))


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    if "--notify" in argv:
        argv = [a for a in argv if a != "--notify"]
        os.environ["KDROP_NOTIFY"] = "1"
    if not argv:
        print(__doc__, file=sys.stderr)
        return 2
    cmd, rest = argv[0], argv[1:]
    if cmd == "_run":   # inside the systemd unit
        kind, rest = rest[0], rest[1:]
        if kind == "send":
            return job_send(rest[2:], rest[1]) if rest[:1] == ["--to"] else job_send(rest, None)
        if kind == "receive":
            return job_receive(int(rest[0]) if rest else 0)   # seconds
        return job_browse()
    if cmd == "_pick" and rest[:1] in (["files"], ["folder"]):
        return pick_dialog(rest[0], rest[1] if len(rest) > 1 else "",
                           rest[2] if len(rest) > 2 else "")
    if cmd == "_cancel-pick":
        return cancel_pick()
    if cmd == "--version":
        print(VERSION)
        return 0
    if cmd == "send":
        if rest[:1] != ["--to"] or len(rest) < 3:
            notify("No device chosen", "Search for devices in the KDrop widget and pick one.",
                   "dialog-warning")
            print("usage: kdrop send --to NAME FILE...", file=sys.stderr)
            return 2
        return launch("send", rest)
    if cmd == "receive":
        if rest[:1] in (["--minutes"], ["--time"]):
            rest = rest[1:]
        try:
            secs = max(15, min(1800, parse_duration(rest[0]))) if rest else 0
        except ValueError as e:
            print(e, file=sys.stderr)
            return 2
        return launch("receive", [str(secs)] if secs else [])
    if cmd == "browse":
        return launch("browse", [])
    if cmd in ("stop", "restart"):
        systemctl("stop", *JOB_UNITS.values())
        radio_down()
        if cmd == "restart":   # also forget job state and failed units, rebuild the Dolphin menu
            systemctl("reset-failed", *JOB_UNITS.values(), RADIO_UNIT)
            for f in RUN.glob("*.json"):
                f.unlink(missing_ok=True)
            shutil.rmtree(RUN / "zips", ignore_errors=True)
            write_menus(load_conf())
        return 0
    if cmd == "status":
        status()
        return 0
    conf = load_conf()
    if cmd == "settings":
        print(json.dumps(conf, indent=2, ensure_ascii=False))
        return 0
    if cmd == "set" and rest and len(rest) % 2 == 0:
        # several pairs at once (the Save button): all are checked before any is saved,
        # and a mode change is applied last, since it may remove the widget that asked
        pairs = list(zip(rest[::2], rest[1::2]))
        new_mode = None
        for key, val in pairs:
            if key == "receive_minutes":   # old name
                key, val = "receive_seconds", str(int(val) * 60)
            if key not in SETTINGS:
                print(f"unknown setting: {key}", file=sys.stderr)
                return 2
            try:
                if key == "receive_seconds" and not val.isdigit():
                    val = parse_duration(val)
                val = SETTINGS[key][1](val)
            except ValueError as e:
                print(f"bad value for {key}: {e}", file=sys.stderr)
                return 2
            if key == "mode":
                new_mode = val
            else:
                conf[key] = val
        save_conf(conf)
        if new_mode and new_mode != conf["mode"]:
            return main(["mode", new_mode])
        return 0
    elif cmd == "trust" and rest:
        for lst in ("trusted", "devices"):
            if not in_list(rest[0], conf[lst]):
                conf[lst].append(rest[0])
    elif cmd == "untrust" and rest:
        conf["trusted"] = [d for d in conf["trusted"] if not same_name(d, rest[0])]
    elif cmd == "forget" and rest:
        for lst in LISTS:
            conf[lst] = [d for d in conf[lst] if not same_name(d, rest[0])]
    elif cmd == "mode" and rest[:1] in (["widget"], ["app"]):
        conf["mode"] = rest[0]
        save_conf(conf)
        err = apply_mode(rest[0])
        if err:
            print(err, file=sys.stderr)
            notify("KDrop", err, "dialog-warning")
        return 1 if err else 0
    elif cmd == "apply-mode":     # used by install.sh: set up whatever the saved mode is
        err = apply_mode(conf["mode"], launch_app=False)
        if err:
            print(err, file=sys.stderr)
        return 1 if err else 0
    elif cmd == "refresh-menu":
        pass
    else:
        print(__doc__, file=sys.stderr)
        return 2
    save_conf(conf)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
